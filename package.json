{
  "name": "astro-kitty-trainer",
  "version": "4.0.0",
  "description": "Astro Kitty: a junior astronaut mission trainer web game for kids aged 7-12, built on real NASA data.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RAFI-ULL-BARI/Astro-Kitty-NASA-Space-Apps.git"
  },
  "homepage": "https://astro-kitty-mission-trainer.vercel.app",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "test": "npm run build && node --test test/*.test.mjs",
    "build": "tsc && npm run build:3d && node scripts/finish-build.mjs",
    "typecheck": "tsc --noEmit",
    "build:3d": "esbuild src/mars-walk/surface.js --bundle --format=esm --target=es2022 --minify --legal-comments=inline --outfile=dist/world/mars-surface.js && esbuild src/colony/main.js --bundle --format=esm --target=es2022 --minify --legal-comments=inline --outfile=dist/world/colony.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "three": "0.187.0"
  }
}
